generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SUPPORT_AGENT
  CLIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole   @default(CLIENT)
  status       UserStatus @default(ACTIVE)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  refreshTokens RefreshToken[]
  client        Client?
  assignedClients Client[] @relation("AssignedClients")
  adminNotes    AdminNote[]
  reviewedKycDocuments KycDocument[] @relation("ReviewedKycDocuments")

  requestedTransactions Transaction[] @relation("RequestedTransactions")
  reviewedTransactions  Transaction[] @relation("ReviewedTransactions")
  transactionAuditLogs  TransactionAuditLog[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  userAgent String?
  ipAddress String?

  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_KYC
}

enum KycStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
}

enum KycDocumentType {
  PASSPORT
  NATIONAL_ID
  DRIVING_LICENSE
  PROOF_OF_ADDRESS
}

enum KycDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Client {
  id          String       @id @default(uuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone       String?
  country     String?
  city        String?
  status      ClientStatus @default(PENDING_KYC)
  kycStatus   KycStatus    @default(NOT_STARTED)
  kycDocuments KycDocument[]

  assignedToId String?
  assignedTo   User?       @relation("AssignedClients", fields: [assignedToId], references: [id])

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  notes       AdminNote[]
  transactions Transaction[]
}

model AdminNote {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  authorId  String
  author    User     @relation(fields: [authorId], references: [id])

  content   String
  createdAt DateTime @default(now())
}

model KycDocument {
  id        String  @id @default(uuid())
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  type      KycDocumentType
  status    KycDocumentStatus @default(PENDING)

  fileName  String
  fileUrl   String
  mimeType  String
  size      Int

  rejectionReason String?

  reviewedById String?
  reviewedBy   User?   @relation("ReviewedKycDocuments", fields: [reviewedById], references: [id])

  reviewedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  FAILED
  CANCELLED
}

model Transaction {
  id          String            @id @default(uuid())
  clientId    String
  client      Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)

  type        TransactionType
  status      TransactionStatus @default(PENDING)

  amount      Decimal           @db.Decimal(18, 2)
  currency    String            @default("USD")

  reference   String?
  description String?

  requestedById String
  requestedBy   User @relation("RequestedTransactions", fields: [requestedById], references: [id])

  reviewedById String?
  reviewedBy   User? @relation("ReviewedTransactions", fields: [reviewedById], references: [id])

  reviewedAt DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs TransactionAuditLog[]
}

model TransactionAuditLog {
  id            String @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  actorId String
  actor   User @relation(fields: [actorId], references: [id])

  action  String
  fromStatus TransactionStatus?
  toStatus   TransactionStatus?

  note      String?
  createdAt DateTime @default(now())
}