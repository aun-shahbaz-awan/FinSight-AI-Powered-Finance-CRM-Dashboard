# Runtime
NODE_ENV=development
PORT=4000

# Local PostgreSQL
POSTGRES_USER=finsight
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finsight_ai
DATABASE_URL=postgresql://finsight:change-me@localhost:5432/finsight_ai

# Local Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication
# Generate each value independently with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret

# Application origins
# APP_URL accepts a comma-separated list of allowed browser origins.
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# AI provider: openai or openrouter
AI_PROVIDER=openrouter

# OpenAI configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# OpenRouter configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Browser-exposed frontend configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
